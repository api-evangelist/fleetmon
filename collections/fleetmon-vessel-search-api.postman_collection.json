  "item": [
    {
      "id": "4894b901-e203-4728-b49c-306b0d329256",
      "name": "Vessel Search",
      "description": {
        "content": "Allows searching over the FleetMon vessel database by name, IMO-number, MMSI-number and/or callsign.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5abedf82-870d-4844-8b0b-524a64e8e0ff",
          "name": "Delivers the list of vessels that matched the criteria.",
          "request": {
            "name": "Delivers the list of vessels that matched the criteria.",
            "description": {
              "content": "",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vesselsearch",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "callsign",
                  "value": "<string>",
                  "description": "only exact matching"
                },
                {
                  "disabled": false,
                  "key": "eni_number",
                  "value": "<long>",
                  "description": "only exact matching"
                },
                {
                  "disabled": false,
                  "key": "imo_number",
                  "value": "<long>",
                  "description": "only exact matching"
                },
                {
                  "disabled": false,
                  "key": "max_pos_age_days",
                  "value": "<long>",
                  "description": "maximum timespan of last received position signal, in days"
                },
                {
                  "disabled": false,
                  "key": "mmsi_number",
                  "value": "<long>",
                  "description": "only exact matching"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "sub-string matching, minium length is 3 characters"
                },
                {
                  "disabled": false,
                  "key": "request_limit_info",
                  "value": "false",
                  "description": "If `true` some extra attributes will be added to the response informing about usage and limits of this endpoint."
                },
                {
                  "disabled": false,
                  "key": "with_position",
                  "value": "true",
                  "description": "request only vessels with a valid position"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
