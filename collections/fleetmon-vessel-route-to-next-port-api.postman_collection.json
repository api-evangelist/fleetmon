              ],
              "query": [
                {
                  "disabled": false,
                  "key": "draught",
                  "value": "<float>",
                  "description": "Draught of vessel in meters (default: latest reported draught from vessel or 1 if draught is unavailable or 0)"
                },
                {
                  "disabled": false,
                  "key": "min_draught",
                  "value": "<float>",
                  "description": "Minimum draught of vessel in meters (default: minimum reported draught from vessel or 1 if draught is unavailable or 0)"
                },
                {
                  "disabled": false,
                  "key": "min_speed",
                  "value": "<float>",
                  "description": "Minimum speed of vessel in knots (default: average vessel speed or 20 if speed is unavailble or 0)"
