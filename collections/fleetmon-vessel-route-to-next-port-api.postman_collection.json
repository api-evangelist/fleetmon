                  "disabled": false,
                  "key": "speed",
                  "value": "<float>",
                  "description": "Speed of vessel in knots (default: latest resported speed from vessel or 20 if speed is unavailble or 0)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "vessel_id",
                  "description": "(Required) FleetMon identifier for maritime objects like vessels"
