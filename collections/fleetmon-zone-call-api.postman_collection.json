          "name": "Delivers a list of call items",
          "request": {
            "name": "Delivers a list of call items",
            "description": {
              "content": "Delivers a list of call items for your zones. Each call contains zone information, vessel information, entered event and left event.\r\nThe events contain latitude, longitude, draft, destination and ETA at the time of entry/leaving.\r\nIt is possible to specify the time frame and whether to include closed and/or open calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "zone",
                "calls",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "closed",
                  "value": "true",
                  "description": "Include closed zone calls"
                },
                {
                  "disabled": false,
                  "key": "collect_time",
                  "value": "3600",
                  "description": "Collect subsequent calls into one, when `departure` - `arrival` < `collect_time`"
                },
                {
                  "disabled": false,
                  "key": "duration_min",
                  "value": "0",
                  "description": "Minimun duration of call, Shorter calls will be discarded"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Start of requested time interval (default: `until` - 1d)"
                },
                {
                  "disabled": false,
                  "key": "open",
                  "value": "false",
                  "description": "Include open zone calls"
                },
                {
                  "disabled": false,
                  "key": "request_limit_info",
                  "value": "false",
                  "description": "If `true` some extra attributes will be added to the response informing about usage and limits of this endpoint."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "End of requested time interval (default: now)"
                },
                {
                  "disabled": false,
                  "key": "zone_id",
                  "value": "<long>",
                  "description": "ID of zone to get calls for"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
