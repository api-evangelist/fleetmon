{
  "opencollection": "1.0.0",
  "info": {
    "name": "FleetMon API Reference Basic Vessel Data Vessel ETA & Destination Change Events API",
    "version": "Version 2.4.2"
  },
  "items": [
    {
      "info": {
        "name": "Vessel ETA & Destination Change Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delivers ETA & Destination Changes for vessels.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/lng_vessel/events/",
            "params": [
              {
                "name": "event_type",
                "value": "",
                "type": "query",
                "description": "Type of event that should be delivered"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Start of requested time interval (default: `until` - 1d)"
              },
              {
                "name": "request_limit_info",
                "value": "",
                "type": "query",
                "description": "If `true` some extra attributes will be added to the response informing about usage and limits of this endpoint."
              },
              {
                "name": "until",
                "value": "",
                "type": "query",
                "description": "End of requested time interval (default: `now`)"
              }
            ]
          },
          "docs": "Delivers ETA & Destination Changes for vessels."
        },
        {
          "info": {
            "name": "Delivers ETA & Destination Changes for a single vessel.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/lng_vessel/events/:vessel_id",
            "params": [
              {
                "name": "vessel_id",
                "value": "",
                "type": "path",
                "description": "ID of vessel to get events for"
              },
              {
                "name": "event_type",
                "value": "",
                "type": "query",
                "description": "Type of event that should be delivered"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Start of requested time interval (default: `until` - 1d)"
              },
              {
                "name": "request_limit_info",
                "value": "",
                "type": "query",
                "description": "If `true` some extra attributes will be added to the response informing about usage and limits of this endpoint."
              },
              {
                "name": "until",
                "value": "",
                "type": "query",
                "description": "End of requested time interval (default: `now`)"
              }
            ]
          },
          "docs": "Delivers ETA & Destination Changes for a single vessel."
        }
      ]
    }
  ],
  "bundled": true
}